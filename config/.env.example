# NaviSsurance — copy to config/.env
#
# This file should contain ONLY secrets: API keys, tokens, passwords, and similar credentials.
#
# Application toggles (runtime scheduler, local API, briefing, CoS memory extraction, local LLM
# tuning, etc.) are edited in the app: menu → Settings → App preferences (stored in SQLite).

# --- Grok / xAI (at least one required for cloud model calls) ---
# GROK_API_KEY=
# XAI_API_KEY=

# --- Dropbox OAuth (optional) ---
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=

# --- Telegram bot (optional; enable the feature in Settings → App preferences) ---
# NAVI_TELEGRAM_BOT_TOKEN=

# --- Other optional API keys used by specific features ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ASSEMBLYAI_API_KEY=
# HUGGINGFACE_TOKEN=

# --- Email fetch (if you use provider passwords in env) ---
# YAHOO_APP_PASSWORD=
# (plus provider account vars as documented for data_fetch)
