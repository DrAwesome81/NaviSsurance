# NaviSsurance environment example
# Copy this file to `config/.env` and fill values as needed.

# --- Workspace reference-pack tuning (defaults) ---
# Higher values include more context in each model call.
WORKSPACE_REF_PACK_MAX_CHARS=60000
WORKSPACE_REF_PACK_CHUNKS_PER_FILE=8
WORKSPACE_REF_PACK_SMALL_FILE_MAX_CHARS=12000

# OpenAI review path uses the same high-profile defaults.
WORKSPACE_REF_PACK_MAX_CHARS_OPENAI=60000
WORKSPACE_REF_PACK_CHUNKS_PER_FILE_OPENAI=8
WORKSPACE_REF_PACK_SMALL_FILE_MAX_CHARS_OPENAI=12000

# --- Optional model settings ---
# OPENAI_MODEL_PRIMARY=gpt-4o
# OPENAI_MODEL_FALLBACK=gpt-4o-mini
# OPENAI_MAX_TOKENS_REVIEW=6000
