QTextEdit {
    background-color: #f8f9fa;
    border: 1px solid #808080; /* Light Gray */
    padding: 10px;
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: white;
}

QTextEdit a {
    color: #0000EE; /* Link color */ 
    text-decoration: underline; /* Underline to indicate it's a link */
    cursor: pointer; /* Changes cursor to a hand indicating clickable link */
}

QTextEdit a:hover {
    color: #551A8B; /* Darker blue on hover */
    text-decoration: none; /* Optionally remove underline on hover for a different effect */
}

QTextEdit a:visited {
    color: #551A8B; /* Purple for visited links */
}

QLineEdit {
    background-color: white;
    border: 1px solid #808080; /* Light Gray */
    padding: 8px;
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: white;
}

QPushButton {
    background-color: rgb(253, 98, 98);
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 5px;
}
QPushButton:hover {
    background-color: #0056b3;
}

QCheckBox {
    margin: 0 5px;
}

QCheckBox::indicator {
    color: white;
}

QCheckBox::indicator:checked {
    color: white;
}

QLabel {
    font-size: 14px;
    margin: 0 5px;
}

QMenuBar {
    background-color: rgb(20, 20, 22);
    color: white;
}

QMenuBar::item {
    background-color: rgb(20, 20, 22);
    color: white;
}

QMenuBar::item:selected { /* For Hover Effect */
    background-color: rgb(30, 30, 34); /* Slightly different shade for visibility */
}

QDateEdit, QDateEdit QAbstractSpinBox, QDateEdit QAbstractSpinBox::down-button, QDateEdit QAbstractSpinBox::up-button,
QLabel {
    color: white;
}