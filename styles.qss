QTextEdit {
    background-color: #f8f9fa;
    border: 1px solid #ced4da;
    padding: 10px;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

QLineEdit {
    background-color: white;
    border: 1px solid #ced4da;
    padding: 8px;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 5px;
}
QPushButton:hover {
    background-color: #0056b3;
}

QCheckBox {
    margin: 0 5px;
}

QLabel {
    font-size: 14px;
    margin: 0 5px;
}
